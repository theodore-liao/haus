{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-status.mjs\"", "timeout": 25 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dev-server.mjs\"", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/kill-test-servers.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/console-followup.mjs\"", "timeout": 15 }
        ]
      }
    ]
  }
}
