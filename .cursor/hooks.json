{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/sync-status.mjs",
        "timeout": 25
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/console-followup.mjs",
        "loop_limit": 1,
        "timeout": 15
      }
    ]
  }
}
