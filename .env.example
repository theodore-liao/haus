# Local SQLite. Prisma resolves this relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Household lock. Required. The whole app sits behind this passphrase.
HAUS_SITE_PASSWORD="change-me"
HAUS_SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# AES-256 key for Plaid access_tokens at rest. Required in production.
# Generate once and never rotate unless you re-encrypt the database:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HAUS_TOKEN_KEY=""

# Cloudflare Access emails (comma-separated). Required for production behind Tunnel.
# Leave empty for local `npm run dev`.
ALLOWED_EMAILS=""

# Public URL of the Tunnel hostname (sets Secure cookies). Example:
# HAUS_PUBLIC_URL="https://haus.example.com"
# HAUS_HTTPS=1
HAUS_PUBLIC_URL=""

# Plaid. Do not commit real secrets.
# Production Trial: one client_id for the household. Max 10 Items shared.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# "production" links real banks. "sandbox" is for Plaid's fake test banks only.
# The secret must match: a sandbox secret does not work in production.
PLAID_ENV="production"
# Transactions is required. Investments and liabilities attach when the accounts support them.
PLAID_PRODUCTS="transactions,investments,liabilities"

# Optional. If unset, holdings show Plaid quantity / value / cost basis only.
FINNHUB_API_KEY=""
