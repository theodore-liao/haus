# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.traineddata
eng.traineddata

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets. .env.example is placeholders only.
.env
.env.*
!.env.example
.dev.vars

# local data (ledger, ID cards, backups)
/data
/backups
*.db
*.db-journal
*.db-wal
*.db-shm
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-wal
/prisma/dev.db-shm

# wrangler / cloudflare local
.wrangler

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# one-shot local remap (contains old owner ids; never publish)
scripts/_local-*
